FROM --platform=linux/amd64 python:3.11-slim

# Confluent 리포지토리 추가 및 monitoring interceptor 설치 (amd64 전용 패키지)
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl gnupg && \
    curl -sL https://packages.confluent.io/deb/7.6/archive.key | gpg --dearmor -o /usr/share/keyrings/confluent.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/confluent.gpg] https://packages.confluent.io/deb/7.6 stable main" \
      > /etc/apt/sources.list.d/confluent.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends confluent-librdkafka-plugins && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# pip confluent-kafka에 번들된 librdkafka를 시스템 경로에 심볼릭 링크
# monitoring-interceptor 플러그인이 librdkafka.so.1을 찾을 수 있도록 함
RUN BUNDLED_LIB=$(find /usr/local/lib -name 'librdkafka*.so.1' | head -1) && \
    if [ -n "$BUNDLED_LIB" ]; then \
      ln -sf "$BUNDLED_LIB" /usr/lib/x86_64-linux-gnu/librdkafka.so.1; \
    fi

COPY . .

CMD ["python", "-u", "step1_basics/01_producer.py"]
